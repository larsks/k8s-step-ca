STEP_CA_NAME=Mass Open Cloud
STEP_DNS_NAMES=ca.massopen.cloud,step-ca,step-ca.step-ca.svc.cluster.local
STEP_SERVER_PROVISIONER_NAME=server
STEP_IDRAC_PROVISIONER_NAME=idrac
STEP_ACME_PROVISIONER_NAME=acme
# Consumed by init-step-ca.sh's build_x509_template_data, not by any
# step-ca authority policy: these become the AllowDNSSuffixes/
# AllowIPPrefixes/AllowedKeyTypes data fed to the idrac and server
# provisioners' shared x509 template (x509-filter.tpl). Comma-separate
# multiple entries. See dns_allow_suffixes/ip_allow_prefixes for the exact
# pattern syntax each accepts; AllowedKeyTypes entries are "RSA", "ECDSA"
# and/or "Ed25519", compared verbatim.
STEP_POLICY_ALLOW_DNS=*.massopen.cloud
STEP_POLICY_ALLOW_IP=10.0.0.0/8
# iDRAC has no EC/Ed25519 support; leaving STEP_SERVER_ALLOWED_KEY_TYPES
# unset (the default) leaves the server provisioner's key type
# unrestricted.
STEP_IDRAC_ALLOWED_KEY_TYPES=RSA
STEP_DEFAULT_CERT_DURATION=2160h
